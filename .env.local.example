# Copy to .env.local for local development, and set the same keys in
# Vercel -> Project Settings -> Environment Variables for production.
# Never commit real values — this file only holds placeholders.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
SUPABASE_SECRET_KEY=replace-with-your-secret-key

# Admin dashboard (/admin)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-random-64-char-hex-string
