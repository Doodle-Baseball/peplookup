# Copy to .env.local for local development, and set the same keys in
# Vercel -> Project Settings -> Environment Variables for production.
# Never commit real values — this file only holds placeholders.

NEXT_PUBLIC_SUPABASE_URL=https://hfvrxqnzkgpnzuuzqfwc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TbCqcZiV9KQMZuWBfQTuCQ_eK5vaPvR
SUPABASE_SECRET_KEY=your_secret_key_here

# Admin dashboard (/admin)
ADMIN_EMAIL=info@peplookup.com
ADMIN_PASSWORD=11@awan22
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=cefe2bbfe8a0751f11bb9ac0319acd4415660815a481b0525dd663c88d2d8a2e

# Vendor listing (/vendor-listing) — Whop checkout + email notifications.
# Sandbox values shown; use the live API host, key and plan ids in production.
WHOP_API_KEY=your_whop_api_key_here
WHOP_API_BASE_URL=https://sandbox-api.whop.com/api/v1
WHOP_ACCOUNT_ID=biz_xxxxxxxxxxxxxx
WHOP_BASIC_PLAN_ID=plan_xxxxxxxxxxxxx
WHOP_PRO_PLAN_ID=plan_xxxxxxxxxxxxx
# Whop dashboard -> Developer -> Webhooks, event: payment.succeeded, URL: https://<your-domain>/api/webhooks/whop
WHOP_WEBHOOK_SECRET=ws_xxxxxxxxxxxxxxxx
# Emails via Resend (https://resend.com). Without these, emails are skipped and logged.
RESEND_API_KEY=your_resend_api_key_here
VENDOR_LISTING_EMAIL_FROM=PepLookup <noreply@peplookup.com>
VENDOR_LISTING_NOTIFY_EMAIL=info@peplookup.com

# Where Whop sends buyers after paying (/thanks). Defaults to https://www.peplookup.com in production;
# set it to an https tunnel address to test the redirect locally.
# WHOP_REDIRECT_BASE_URL=https://your-tunnel.example.com

# SEO monitoring (/api/cron/*, scheduled in vercel.json).
# Vercel sends "Authorization: Bearer $CRON_SECRET" with every cron call; the jobs refuse to run without it.
CRON_SECRET=generate_a_long_random_string
# Where SEO and uptime alerts go, and who they come from (defaults: VENDOR_LISTING_NOTIFY_EMAIL / VENDOR_LISTING_EMAIL_FROM).
SEO_ALERT_EMAIL=info@peplookup.com
# SEO_ALERT_EMAIL_FROM=PepLookup <alerts@peplookup.com>
# Google Search Console API: a service account added as a user on the property (Settings -> Users and permissions).
GSC_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"
GSC_SITE_URL=https://www.peplookup.com/
# One deploy only: allow the sitemap to change by more than 20% when that is intended (scripts/seo-check.mjs).
# SEO_CHECK_EXPECTED_SITEMAP_COUNT=
